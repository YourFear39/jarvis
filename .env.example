# Провайдер LLM: "cerebras", "gemini", "claude", "ollama"
LLM_PROVIDER=gemini

# Cerebras Cloud (OpenAI-совместимый, llama-3.3-70b)
CEREBRAS_API_KEY=

# Google Gemini — несколько ключей через запятую, переключаются автоматически
# Добавляй ключи с новых аккаунтов сюда:
GEMINI_API_KEYS=

# Anthropic Claude (добавь позже, когда понадобится)
ANTHROPIC_API_KEY=

# Ollama (локальная модель, если установлена)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Микрофон для записи (None = автовыбор Windows default)
# Узнать список: python list_devices.py
# Если wake word не слышит — попробуй AUDIO_INPUT_DEVICE=2 (PRO X headset)
# AUDIO_INPUT_DEVICE=

# Имя пользователя (используется в приветствиях)
# JARVIS_USER_NAME=Влад

# ── TTS (голос) ──────────────────────────────────────────────────────────────
# Движок озвучки: "edge" (по умолчанию) или "elevenlabs"
TTS_ENGINE=edge

# ElevenLabs API ключ (получить: https://elevenlabs.io → Profile → API Key)
ELEVENLABS_API_KEY=

# ID голоса ElevenLabs (варианты — в config.py, рекомендован Daniel)
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# ── Groq API (Level 2 поиск) ─────────────────────────────────────────────────
# Ключ Groq (бесплатно: https://console.groq.com → API Keys)
GROQ_API_KEY=

DISCORD_BYPASS_PATH=
